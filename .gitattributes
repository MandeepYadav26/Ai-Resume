# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files you want to always be normalized and converted to LF on checkout.
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf

# Deny text conversion for binary files
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
